    "# 📐 Binary cross-entropy illustration\n",
    "def binary_cross_entropy(y_true, y_pred):\n",
    "    eps = 1e-15\n",
    "    y_pred = np.clip(y_pred, eps, 1 - eps)\n",
    "    return -(y_true * np.log(y_pred) + (1 - y_true) * np.log(1 - y_pred))\n",
    "\n",
    "y_true = np.array([1.0])\n",
    "example_loss = binary_cross_entropy(y_true, np.array([float(y_hat[0, 0])]))[0]\n",
    "print(\"True label:\", y_true[0])\n",
    "print(\"Predicted probability:\", float(y_hat[0, 0]))\n",
    "print(\"Binary cross-entropy loss:\", float(example_loss))"
   ]
